# ======================================================================
# ERP Matériaux de construction — Backend
# Copier vers `.env` et adapter les valeurs avant déploiement.
# ======================================================================

# --- Application ---
DEBUG=false
ENVIRONMENT=production

# --- Sécurité (OBLIGATOIRE : changer en prod !) ---
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGEZ_MOI_cle_secrete_tres_longue_et_aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base de données ---
# Développement local (SQLite, aucune dépendance) :
DATABASE_URL=sqlite+aiosqlite:///./erp_dev.db
# Production (Docker/PostgreSQL) :
# DATABASE_URL=postgresql+psycopg://erp_user:MOT_DE_PASSE_FORT@db:5432/erp_db

# --- Bootstrap premier démarrage (compte admin initial) ---
BOOTSTRAP_ON_STARTUP=true
FIRST_ADMIN_EMAIL=admin@abc.com
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_COMPANY_CODE=ABC

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Monitoring (optionnel) ---
# SENTRY_DSN=

# NOTE :
# - En production (DEBUG=false), le CORS est désactivé : l'application
#   doit être servie en même origine via nginx (/api → backend).
# - L'URL du QR code du ticket de caisse est un paramètre applicatif
#   (« pos_ticket_url ») modifiable dans Paramètres de l'application.

