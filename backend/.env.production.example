# ======================================================================
# ERP Matériaux de construction — Configuration PRODUCTION
# Copier vers `backend/.env` sur le serveur (ou monter via secret Docker)
# et adapter AVANT le déploiement. Ne jamais committer le vrai fichier.
# ======================================================================

# --- Application ---
ENVIRONMENT=production
DEBUG=false
# Doc interactive auto-désactivée en production (protection défensive
# dans app/main.py) — la variable ci-dessous n'a donc plus d'effet.
DOCS_ENABLED=false

# --- Sécurité (OBLIGATOIRE : générer une clé unique par installation) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=COLLEZ_ICI_UNE_CLE_ALEATOIRE_DE_64_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=erp-materiaux

# --- Base de données : PostgreSQL (container `db` du docker-compose) ---
DATABASE_URL=postgresql+psycopg://erp_user:MOT_DE_PASSE_FORT@db:5432/erp_db
# NB : changer aussi POSTGRES_PASSWORD dans docker-compose.yml — les
# valeurs erp_user/erp_pass par défaut ne doivent PAS partir en prod.

# --- Redis / Celery (containers du compose) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Bootstrap premier démarrage (créé SEULEMENT si la base est vide) ---
BOOTSTRAP_ON_STARTUP=true
FIRST_COMPANY_NAME=Groupe Entreprise AKA
FIRST_COMPANY_CODE=GEA
FIRST_COMPANY_CURRENCY=XOF
FIRST_ADMIN_EMAIL=admin@abc.com
FIRST_ADMIN_PASSWORD=MOT_DE_PASSE_FORT_A_DEFINIR
FIRST_ADMIN_FIRST_NAME=Admin
FIRST_ADMIN_LAST_NAME=Système

# --- Stockage fichiers (repli disque si pas de S3) ---
# Chemin relatif -> résolu depuis /app (WORKDIR du conteneur).
# Pour un volume dédié, utiliser un chemin absolu et le monter dans le compose.
LOCAL_STORAGE_PATH=resources/uploads

# --- CORS (P1/S-4) ---
# Origines autorisées (frontend sur domaine distinct uniquement).
# Derrière nginx (même origine), laisser vide.
CORS_ORIGINS=

# --- Monitoring (optionnel) ---
# SENTRY_DSN=
